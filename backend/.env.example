# AMP Ventures Agency Environment Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (Defaults to local SQLite in /backend/amp_ventures.db)
DATABASE_URL=sqlite:///./amp_ventures.db

# WhatsApp Business API / Click-to-Chat Number (E.164 format without spaces)
WHATSAPP_NUMBER=+919876543210
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token_here

# Email Notification API (e.g. Resend, Sendgrid, or SMTP)
EMAIL_API_KEY=your_email_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@ampventures.agency
SMTP_PASSWORD=your_app_password

# AI Chatbot LLM Provider (Optional for full LLM connection)
OPENAI_API_KEY=your_openai_or_anthropic_api_key_here

# Admin Dashboard Secret
ADMIN_SECRET_KEY=amp_admin_secret_key_2026
