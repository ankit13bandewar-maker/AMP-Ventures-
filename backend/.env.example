# AMP Ventures Agency Environment Configuration
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Agency Information & Contact
WHATSAPP_NUMBER=+919876543210

# Security, Admin & JWT Authentication
ADMIN_SECRET_KEY=amp_admin_secret_key_2026
JWT_SECRET_KEY=amp_ventures_secure_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=60

# Database & Supabase Cloud (Optional - if empty, local SQLite amp_ventures.db is used automatically)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
DATABASE_ENGINE=auto

# Redis / Distributed Cache (Optional - if left empty, in-memory LRU TTL is used)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# Email Notification API (e.g. Resend, Sendgrid, or SMTP)
EMAIL_API_KEY=your_email_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@ampventures.agency
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL_TO=contact@ampventures.agency

# Instant Mobile Notification Webhooks (Discord & Telegram)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI Chatbot LLM Provider (Optional OpenAI / Google Gemini)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Observability, Logging & Sentry APM (Optional)
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
SENTRY_DSN=
